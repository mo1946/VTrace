# Browser URLs: same-origin proxies avoid changing Java/Python CORS behavior.
VITE_API_BASE_URL=/api
VITE_BUSINESS_API_BASE_URL=/business-api
VITE_ANALYSIS_BACKEND=java
# For rollback set VITE_ANALYSIS_BACKEND=python, restart Vite / rebuild the frontend.
PYTHON_API_TARGET=http://127.0.0.1:9090
BUSINESS_API_TARGET=http://127.0.0.1:8080
